# ==============================================================================
# Шаблон конфигурации окружения для OpenVPN Web Hub (All-in-One Container)
# Переименуйте этот файл в .env и настройте параметры ниже
# ==============================================================================

# Хост и порт для запуска веб-панели (по умолчанию 5000)
BIND_HOST=0.0.0.0
BIND_PORT=5000

# ==============================================================================
# Настройки OpenVPN сервера
# ==============================================================================
# Порт и протокол для входящих VPN-подключений клиентов
OPENVPN_PORT=1194
OPENVPN_PROTO=udp

# Внешний публичный IP или DNS-хостнейм сервера (если пусто, определится автоматически через curl)
PUBLIC_IP=

# Отображаемое имя этой ноды VPN в интерфейсе
NODE_NAME=VPN-Gateway-1

# ==============================================================================
# Авторизация и доступ
# ==============================================================================
# Режим авторизации:
# central    = авторизация через центральный сервер centralized-auth (SSO)
# standalone = автономный запуск со своей локальной учетной записью администратора
AUTH_MODE=central

# Параметры локального администратора для автономного режима (AUTH_MODE=standalone)
STANDALONE_ADMIN_USER=admin
STANDALONE_ADMIN_PASSWORD=admin123

# Разграничение прав и роли Администраторов (RBAC):
# Список логинов/email (через запятую), которые автоматически получают права Администратора:
ADMIN_USERS=admin,operator_lead
# Название группы администраторов из центра авторизации/LDAP:
ADMIN_GROUP=VPN_Admins

# Секретный ключ для подписи сессий Flask (обязательно смените в продакшне)
# Для генерации случайного ключа выполните команду: openssl rand -hex 16
SECRET_KEY=default-secret-key-change-me-please

# URL-адрес Центрального сервера авторизации (centralized-auth)
CENTRAL_AUTH_URL=http://host.docker.internal:5001

# Токен для авторизации ноды (должен символ-в-символ совпадать с токеном в центре авторизации)
NODE_API_TOKEN=default-token-change-me-please

# Проверка SSL-сертификата центра авторизации (false для самоподписанных сертификатов)
VERIFY_SSL=false

# ==============================================================================
# Настройки мультитуннелей и изоляции интерфейсов (Windows Wintun / dev-node)
# ==============================================================================
# Включить автоматическое добавление dev-node в конфиги для Windows (true / false)
DEV_NODE_ENABLED=true

# Единое общее имя виртуального адаптера Wintun
DEV_NODE_NAME=VPN-ADAPTER
DEV_NODE_PREFIX=VPN-ADAPTER

# Режим именования интерфейса:
# common     = единый общий адаптер для всех клиентов: DEV_NODE_NAME (рекомендуется)
# none       = директива dev-node не добавляется (стандартный TAP/TUN)
DEV_NODE_MODE=common

# Все постоянные данные (PKI, конфиги, CCD, ovpn) хранятся в папке ./data проекта
DATA_DIR=/app/data
