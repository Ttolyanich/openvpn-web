[Unit]
Description=OpenVPN Web Management Panel
After=network.target openvpn-server@server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/openvpn-web
Environment=BIND_HOST=0.0.0.0 BIND_PORT=5000
EnvironmentFile=-/opt/openvpn-web/.env
ExecStart=/usr/bin/python3 -m gunicorn --workers 2 --bind ${BIND_HOST}:${BIND_PORT} app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
